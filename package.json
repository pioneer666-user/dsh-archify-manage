{
  "name": "@specdev/dsh-archify-manage",
  "version": "0.1.11",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "DSH 流程图管理插件：浏览 Archify 业务流程图目录、按 Git 附注标签阅读历史版本、登记有名称的版本；唯一写操作是给提交挂附注标签，不改业务项目的文件、分支与提交。",
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "web",
    "vendor",
    "skills",
    "client.js",
    "cordis.patch.yml",
    "README.zh.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "node scripts/build.mjs",
    "pack:tgz": "npm run typecheck && npm run build && npm pack --pack-destination ."
  },
  "devDependencies": {
    "@types/node": "26.5.1",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
